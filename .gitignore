# Dependency directories
node_modules/
*/node_modules/
apps/*/node_modules/
server/node_modules/

# Production build outputs
dist/
*/dist/
apps/*/dist/
build/
*/build/

# Local environment variables
.env
.env.local
.env.*.local
!.env.example
!*/.env.example
!apps/*/.env.example
!server/.env.example

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime generated data & temp files
data/*.json
server/data/*.json
*.tmp
*.sqlite-journal

# Operating system files
.DS_Store
Thumbs.db

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo

# AI Assistant & internal workspace metadata
.gemini/

# Firmware local secrets
firmware/**/config.h
!firmware/**/config.h.example
