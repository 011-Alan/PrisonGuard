# ========================================================
# PrisonGuard Facility Simulator (Website B) Environment Config
# ========================================================

# Base HTTP URL of the deployed PrisonGuard backend API
# Local default: http://localhost:5000
# Production example: https://prisonguard-backend.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# WebSocket / Socket.IO URL (Usually same as VITE_API_BASE_URL, with wss:// in production)
VITE_WS_URL=http://localhost:5000

# Cross-Link URL to the independently deployed Admin Portal
# Local default: http://localhost:5173
# Production example: https://prisonguard-admin.vercel.app
VITE_ADMIN_URL=http://localhost:5173
