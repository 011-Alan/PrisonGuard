# ========================================================
# PrisonGuard Admin Portal (Website A) Environment Config
# ========================================================

# Base HTTP URL of the deployed PrisonGuard backend API
# Local default: http://localhost:5000
# Production example: https://prisonguard-backend.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# WebSocket / Socket.IO URL (Usually same as VITE_API_BASE_URL, with wss:// in production)
VITE_WS_URL=http://localhost:5000

# Cross-Link URL to the independently deployed 2D Facility Simulator
# Local default: http://localhost:5174
# Production example: https://prisonguard-sim.vercel.app
VITE_SIMULATOR_URL=http://localhost:5174
