# ========================================================
# PrisonGuard Core Backend Environment Configuration
# ========================================================

# Server listening port (default: 5000)
PORT=5000

# Node environment ('development' | 'production')
NODE_ENV=development

# JWT Secret Key for RBAC token signing (Must be set to a strong random value in production!)
JWT_SECRET=prisonguard_academic_jwt_secret_key_2026

# Allowed Frontend Origins for CORS & Socket.IO (comma-separated for multiple domains)
# Example production: https://prisonguard-admin.vercel.app,https://prisonguard-sim.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Specific Origins for Admin and Simulator Frontends
ADMIN_ORIGIN=http://localhost:5173
SIMULATOR_ORIGIN=http://localhost:5174

# External MQTT Broker (Optional; when left empty, internal simulated MQTT engine is used)
# MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Persistent Data Storage Path
DATA_STORE_PATH=./data/prisonguard_store.json
