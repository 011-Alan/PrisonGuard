/**
 * PrisonGuard — ESP32 Physical Door Controller Configuration
 * Copy this file to "config.h" and fill in your network and server credentials.
 * 
 * Hardware Bill of Materials (Strictly):
 *  - ESP32 DevKit V1 (Wi-Fi + Bluetooth)
 *  - Tower Pro SG90 9g Micro Servo (PWM on GPIO 13)
 *  - RC522 13.56 MHz RFID Reader (SPI: SS 5, SCK 18, MOSI 23, MISO 19, RST 22)
 *  - Red LED (GPIO 25 through 220Ω resistor, cathode to GND)
 *  - Green LED (GPIO 26 through 220Ω resistor, cathode to GND)
 *  - 220-ohm resistors (Red-Red-Brown-Gold)
 *  - Breadboard & Jumper Wires
 */

#ifndef CONFIG_H
#define CONFIG_H

// ==============================================================================
// 1. Wi-Fi Network Credentials
// ==============================================================================
const char* WIFI_SSID     = "YOUR_WIFI_SSID";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// ==============================================================================
// 2. PrisonGuard Backend Server URL
// ==============================================================================
// For local testing on LAN, use your computer's local IP (e.g. "http://192.168.1.100:5000")
// Note: "localhost" or "127.0.0.1" cannot be reached by ESP32 over Wi-Fi!
// For deployed cloud backend, use your Render HTTPS URL (e.g. "https://prisonguard-server.onrender.com")
const char* SERVER_BASE_URL = "http://192.168.1.100:5000";

// Unique Device Identity and Pre-Shared Authentication Secret
// Must match HARDWARE_CONTROLLER_ID and HARDWARE_DEVICE_TOKEN in backend environment
const char* CONTROLLER_ID = "CELL-01-PHYSICAL";
const char* DEVICE_TOKEN  = "pg-hw-secret-token-esp32-demo";

// ==============================================================================
// 3. GPIO Pin Mappings (ESP32 DevKit V1)
// ==============================================================================
#define PIN_SERVO      13   // SG90 Micro Servo PWM signal
#define PIN_LED_RED    25   // Red LED Anode (Cathode to GND via 220Ω resistor)
#define PIN_LED_GREEN  26   // Green LED Anode (Cathode to GND via 220Ω resistor)

// RC522 RFID SPI Pins (VSPI Hardware Bus)
#define PIN_RFID_SS    5    // Slave Select (SDA / CS)
#define PIN_RFID_RST   22   // Hardware Reset Pin
#define PIN_RFID_SCK   18   // SPI Clock (SCK)
#define PIN_RFID_MISO  19   // SPI MISO
#define PIN_RFID_MOSI  23   // SPI MOSI

// ==============================================================================
// 4. Actuator Angles & Timing Configuration
// ==============================================================================
#define SERVO_ANGLE_CLOSED 0    // Commanded angle for locked/closed state (degrees)
#define SERVO_ANGLE_OPEN   90   // Commanded angle for open state (degrees)
#define SERVO_STEP_DELAY_MS 15  // Milliseconds between 1-degree servo transit steps

#define POLL_INTERVAL_MS      500   // Command polling cycle frequency (milliseconds)
#define HEARTBEAT_INTERVAL_MS 5000  // Heartbeat ping interval to server (milliseconds)
#define RFID_COOLDOWN_MS      2500  // Milliseconds before allowing re-scan of same card
#define DOOR_AUTO_CLOSE_MS    4000  // Auto-close duration after authorized RFID badge scan (0 = stay open)

#endif // CONFIG_H
